{
  "name": "@gdacm/querybuilder-influxdb2",
  "version": "0.1.13",
  "author": "gissehel",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean:local": "rm -rf dist .turbo",
    "dev": "vite build --watch",
