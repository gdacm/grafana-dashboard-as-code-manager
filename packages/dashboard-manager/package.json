{
  "name": "@gdacm/dashboard-manager",
  "version": "0.1.15",
  "author": "gissehel",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean:local": "rm -rf dist .turbo",
    "dev": "vite build --watch",
    "build:js": "vite build",
    "build:types": "tsc -p tsconfig.types.json",
    "build": "yarn build:js && yarn build:types"
  },
  "dependencies": {
    "@gdacm/base-types": "workspace:^",
    "@gdacm/grafana-items": "workspace:^",
    "js-yaml": "^5.2.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
