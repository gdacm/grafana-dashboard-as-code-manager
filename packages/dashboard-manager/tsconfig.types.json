        "allowJs": true,
        "checkJs": true,
        "declaration": true,
        "emitDeclarationOnly": true,
        "rootDir": "./src",
        "outDir": "./dist",
        "types": [
            "node"
        ],
    },
    "include": [
        "src/**/*.js"
    ]
